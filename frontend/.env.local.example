VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Vapi Voice AI — get your Public Key from https://dashboard.vapi.ai → Account
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Must be the publicly reachable URL of your backend (Vapi's servers call this, not the browser)
# Do NOT use localhost here in production — use your deployed backend URL e.g. https://your-backend.onrender.com
VITE_VAPI_BACKEND_URL=https://your-backend.onrender.com
