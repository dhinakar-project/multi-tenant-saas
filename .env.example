# Copy this file to .env.local and fill in real values before running.
# NEVER commit .env.local or .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USERNAME=saas_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
CLERK_JWKS_URL=
CLERK_ISSUER=

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Vapi Voice AI ─────────────────────────────────────────────────────────────
# Get from: https://dashboard.vapi.ai
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_BACKEND_URL=http://localhost:8081

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8081

# ── Resend Email (Optional) ───────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Verify your sending domain in Resend dashboard before production use
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Observability (Docker Compose only) ───────────────────────────────────────
# Grafana admin password (default: admin)
# Prometheus auto-scrapes http://backend:8080/actuator/prometheus
# Access Grafana at: http://localhost:3000
